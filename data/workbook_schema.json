{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "definitions": {
    "ministryAssignment": {
      "additionalProperties": false,
      "description": "A segment with title, duration, and multiple participants",
      "properties": {
        "title": {
          "minLength": 1,
          "type": "string"
        },
        "duration": {
          "pattern": "^\\d+:\\d+$",
          "type": "string"
        },
        "who": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "type": "array"
        },
        "description": {
          "description": "Optional description of the ministry part",
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "publication_code": {
          "description": "Publication to be considered (for example, 'th' or 'lmd')",
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "kind": {
          "description": "Kind of ministry part",
          "enum": [
            "starting_a_conversation",
            "following_up",
            "what_would_you_say",
            "making_disciples",
            "explaining_your_beliefs",
            "talk"
          ],
          "type": "string"
        },
        "is_talk": {
          "default": false,
          "description": "Whether this part is a talk",
          "type": "boolean"
        }
      },
      "required": [
        "kind",
        "is_talk",
        "duration",
        "title",
        "description",
        "publication_code",
        "who"
      ],
      "if": {
        "properties": {
          "is_talk": {
            "const": true
          }
        },
        "required": [
          "is_talk"
        ]
      },
      "then": {
        "properties": {
          "kind": {
            "enum": [
              "speech",
              "explaining_your_beliefs"
            ]
          }
        },
        "required": [
          "kind"
        ]
      },
      "type": "object"
    },
    "bibleReadingAssignment": {
      "additionalProperties": false,
      "description": "A segment with title, duration, and a single reader",
      "properties": {
        "title": {
          "minLength": 1,
          "type": "string"
        },
        "duration": {
          "pattern": "^\\d+:\\d+$",
          "type": "string"
        },
        "reader": {
          "minLength": 1,
          "type": "string"
        },
        "publication_code": {
          "description": "Publication to be considered (for example, 'th' or 'lmd')",
          "type": [
            "string",
            "null"
          ],
          "default": "th"
        }
      },
      "required": [
        "duration",
        "title",
        "reader"
      ],
      "type": "object"
    },
    "normalWeek": {
      "additionalProperties": false,
      "description": "A regular week with full meeting agenda",
      "properties": {
        "kind": {
          "enum": [
            "normal"
          ],
          "type": "string"
        },
        "week": {
          "description": "Week date range (e.g., '25-31 de maio')",
          "minLength": 1,
          "type": "string"
        },
        "bible_reading": {
          "description": "Bible reading reference (e.g., 'ISAÍAS 65-66')",
          "minLength": 1,
          "type": "string"
        },
        "chairman": {
          "description": "Name of the chairman",
          "minLength": 1,
          "type": "string"
        },
        "songs": {
          "description": "List of songs to be performed (must be exactly 3)",
          "items": {
            "description": "Song identifier (e.g., 'Cântico 24')",
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 3,
          "minItems": 3,
          "type": "array"
        },
        "prayers": {
          "description": "List of prayers to be performed (must be exactly 2)",
          "items": {
            "description": "Prayer identifier or description",
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 2,
          "minItems": 2,
          "type": "array"
        },
        "initial_comments": {
          "additionalProperties": false,
          "description": "Initial comments section",
          "properties": {
            "title": {
              "default": "Comentários Iniciais",
              "minLength": 1,
              "type": "string"
            },
            "duration": {
              "description": "Duration of the segment (e.g., '1:00')",
              "default": "1:00",
              "pattern": "^\\d+:\\d+$",
              "type": "string"
            },
            "who": {
              "description": "Person responsible for initial comments",
              "minLength": 1,
              "type": "string"
            }
          },
          "required": [
            "title",
            "duration",
            "who"
          ],
          "type": "object"
        },
        "treasures": {
          "additionalProperties": false,
          "description": "Spiritual treasures section with multiple subsections",
          "properties": {
            "speech": {
              "$ref": "#/definitions/segment",
              "properties": {
                "duration": {
                  "default": "10:00"
                }
              }
            },
            "spiritual_gems": {
              "$ref": "#/definitions/segment",
              "unevaluatedProperties": false,
              "properties": {
                "duration": {
                  "default": "10:00"
                }
              },
              "type": "object"
            },
            "bible_reading": {
              "$ref": "#/definitions/segment",
              "unevaluatedProperties": false,
              "properties": {
                "duration": {
                  "default": "4:00"
                }
              },
              "type": "object"
            }
          },
          "required": [
            "speech",
            "spiritual_gems",
            "bible_reading"
          ],
          "type": "object"
        },
        "ministry": {
          "description": "Ministry demonstrations and talks",
          "items": {
            "$ref": "#/definitions/ministryAssignment"
          },
          "minItems": 1,
          "type": "array"
        },
        "christian_life": {
          "additionalProperties": false,
          "description": "Christian life section with discussion parts and congregation study",
          "properties": {
            "parts": {
              "items": {
                "$ref": "#/definitions/segment"
              },
              "minItems": 1,
              "type": "array"
            },
            "congregation_study": {
              "additionalProperties": false,
              "description": "Congregation Bible study",
              "properties": {
                "title": {
                  "minLength": 1,
                  "type": "string"
                },
                "duration": {
                  "pattern": "^\\d+:\\d+$",
                  "type": "string",
                  "default": "30:00"
                },
                "conductor": {
                  "minLength": 1,
                  "type": "string"
                },
                "reader": {
                  "minLength": 1,
                  "type": "string"
                }
              },
              "required": [
                "title",
                "duration",
                "conductor",
                "reader"
              ],
              "type": "object"
            }
          },
          "required": [
            "parts",
            "congregation_study"
          ],
          "type": "object"
        },
        "final_comments": {
          "$ref": "#/definitions/segment",
          "unevaluatedProperties": false,
          "description": "Final comments section",
          "properties": {
            "title": {
              "default": "Comentários finais"
            },
            "duration": {
              "default": "3:00"
            }
          }
        },
        "link": {
          "description": "Optional link to the meeting agenda document",
          "format": "uri",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "week",
        "bible_reading",
        "chairman",
        "songs",
        "prayers",
        "initial_comments",
        "treasures",
        "ministry",
        "christian_life",
        "final_comments",
        "link"
      ],
      "title": "Normal Meeting Week",
      "type": "object"
    },
    "segment": {
      "additionalProperties": false,
      "description": "A segment with speaker, title, and duration",
      "properties": {
        "title": {
          "minLength": 1,
          "type": "string"
        },
        "duration": {
          "pattern": "^\\d+:\\d+$",
          "type": "string"
        },
        "who": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "title",
        "duration",
        "who"
      ],
      "type": "object"
    },
    "specialEventWeek": {
      "additionalProperties": false,
      "description": "A week with no regular meeting (e.g., convention, assembly, special event)",
      "properties": {
        "kind": {
          "enum": [
            "specialEvent"
          ],
          "type": "string"
        },
        "week": {
          "description": "Week date range",
          "minLength": 1,
          "type": "string"
        },
        "bible_reading": {
          "description": "Bible reading reference",
          "minLength": 1,
          "type": "string"
        },
        "no_meeting": {
          "description": "Flag indicating this is a special event week with no meeting",
          "enum": [
            true
          ],
          "type": "boolean"
        },
        "reason": {
          "description": "Reason for no meeting (e.g., 'Convenção de Circuito', 'Assembleia Regional')",
          "minLength": 1,
          "type": "string"
        },
        "link": {
          "description": "Optional link to the meeting agenda document",
          "format": "uri",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "week",
        "bible_reading",
        "no_meeting",
        "reason",
        "link"
      ],
      "title": "Special Event Week",
      "type": "object"
    },
    "visitWeek": {
      "additionalProperties": false,
      "description": "A week when an important visitor replaces the congregation study with their speech",
      "properties": {
        "kind": {
          "enum": [
            "visit"
          ],
          "type": "string"
        },
        "week": {
          "minLength": 1,
          "type": "string"
        },
        "bible_reading": {
          "minLength": 1,
          "type": "string"
        },
        "chairman": {
          "minLength": 1,
          "type": "string"
        },
        "songs": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 3,
          "minItems": 3,
          "type": "array"
        },
        "prayers": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 2,
          "minItems": 2,
          "type": "array"
        },
        "initial_comments": {
          "additionalProperties": false,
          "properties": {
            "title": {
              "default": "Comentários Iniciais",
              "minLength": 1,
              "type": "string"
            },
            "duration": {
              "default": "1:00",
              "pattern": "^\\d+:\\d+$",
              "type": "string"
            },
            "who": {
              "minLength": 1,
              "type": "string"
            }
          },
          "required": [
            "title",
            "duration",
            "who"
          ],
          "type": "object"
        },
        "treasures": {
          "additionalProperties": false,
          "properties": {
            "speech": {
              "$ref": "#/definitions/segment",
              "properties": {
                "duration": {
                  "default": "10:00"
                }
              }
            },
            "spiritual_gems": {
              "$ref": "#/definitions/segment",
              "unevaluatedProperties": false,
              "properties": {
                "duration": {
                  "default": "10:00"
                }
              },
              "type": "object"
            },
            "bible_reading": {
              "$ref": "#/definitions/segment",
              "unevaluatedProperties": false,
              "properties": {
                "duration": {
                  "default": "4:00"
                }
              },
              "type": "object"
            }
          },
          "required": [
            "speech",
            "spiritual_gems",
            "bible_reading"
          ],
          "type": "object"
        },
        "ministry": {
          "items": {
            "$ref": "#/definitions/ministryAssignment"
          },
          "minItems": 1,
          "type": "array"
        },
        "christian_life": {
          "additionalProperties": false,
          "properties": {
            "parts": {
              "items": {
                "$ref": "#/definitions/segment"
              },
              "minItems": 1,
              "type": "array"
            },
            "overseer_speech": {
              "$ref": "#/definitions/segment",
              "additionalProperties": false,
              "description": "Visiting speaker who addresses the congregation",
              "required": [
                "name",
                "title",
                "duration"
              ],
              "type": "object"
            }
          },
          "required": [
            "parts",
            "overseer_speech"
          ],
          "type": "object"
        },
        "final_comments": {
          "$ref": "#/definitions/segment",
          "unevaluatedProperties": false,
          "properties": {
            "title": {
              "default": "Comentários finais"
            },
            "duration": {
              "default": "3:00"
            }
          }
        },
        "link": {
          "description": "Optional link to the meeting agenda document",
          "format": "uri",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "week",
        "bible_reading",
        "chairman",
        "songs",
        "prayers",
        "initial_comments",
        "treasures",
        "ministry",
        "christian_life",
        "final_comments",
        "link"
      ],
      "title": "Visit Week",
      "type": "object"
    }
  },
  "description": "Collection of week documents for workbook generation. Each document can be a normal week, special event, or visit week.",
  "items": {
    "oneOf": [
      {
        "$ref": "#/definitions/normalWeek"
      },
      {
        "$ref": "#/definitions/specialEventWeek"
      },
      {
        "$ref": "#/definitions/visitWeek"
      }
    ]
  },
  "title": "Workbook Collection",
  "type": "array"
}
